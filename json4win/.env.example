# Copy to json4win/.env.local (gitignored) and fill in. Every variable the app reads is listed here.
# Variables already set in the environment win over this file.

# LLM: Mistral La Plateforme (EU), OpenAI-compatible chat completions (architecture D11)
MISTRAL_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL_DECISION=zai-glm-5-3-flash
LLM_MODEL_EXTRACT=zai-glm-5-3-flash

# OCR: Unlimited-OCR-2, local CPU (architecture D10)
OCR_THREADS=
# 1 = never run the model; a page missing from the cache is an error (dev/eval)
OCR_CACHE_ONLY=0

# Cache dir shared by all worktrees; empty = per-user default (~/.cache/json4win, %LOCALAPPDATA%\json4win)
JSON4WIN_CACHE_DIR=
