# Copy to json4win/.env.local (gitignored) and fill in. Every variable the app reads is listed here.
# Variables already set in the environment win over this file.

# LLM: Mistral La Plateforme, OpenAI-compatible (architecture D11). Dev uses the global endpoint (cheaper);
# delivery switches to the EU regional endpoint https://api.eu.mistral.ai/v1 (task D1, docs/compliance.md)
MISTRAL_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL_DECISION=zai-glm-5-3-flash
LLM_MODEL_EXTRACT=zai-glm-5-3-flash
# Token budget per call; reasoning models spend most of it thinking (empty = 16000)
LLM_MAX_TOKENS=
# reasoning_effort for every call's first attempt: low | high | max | off (empty = low; off = not
# sent, the model's default, which on GLM-5.3-Flash reasons far more than high); per role, falling back to
# LLM_REASONING_EFFORT: the decision call is short and simple, the extraction call is the hard one
LLM_REASONING_EFFORT=
LLM_REASONING_EFFORT_DECISION=
LLM_REASONING_EFFORT_EXTRACT=
# An unusable answer (finish_reason=length from thinking too long, empty text, bad JSON) is retried
# this many times (empty = 2): same budget with a lower reasoning effort, then the budget doubled
# per retry up to LLM_MAX_TOKENS_CAP (empty = 64000); LLM_TIMEOUT scales with the budget
LLM_ANSWER_RETRIES=
LLM_MAX_TOKENS_CAP=
# reasoning_effort sent on those retries: low | high | max | off (empty = low; off = keep the first
# attempt's); if the first attempt already used it, the retries go straight to the larger budgets.
# A model that rejects reasoning_effort gets a "reason briefly" line in the system prompt instead
LLM_RETRY_REASONING_EFFORT=
# random_seed sent with every call (empty = 42); Mistral accepts it, but GLM answers still vary
LLM_SEED=
# Seconds per HTTP request (empty = 180) and retries on 429/5xx/timeouts (empty = 4)
LLM_TIMEOUT=
LLM_HTTP_RETRIES=
# Times invalid fields are sent back to the extraction model before they become null (empty = 2)
LLM_VALIDATION_RETRIES=

# OCR backend: local (default, Unlimited-OCR-2 on CPU) | tesseract (Tesseract CLI, Apache 2.0)
# | lighton (LightOnOCR-2-1B, benchmark-only: needs .venv-lighton, docs/ocr.md)
# | hybrid (first pages by OCR_HYBRID_FIRST, the rest by OCR_HYBRID_REST; default lighton + tesseract,
#   so benchmark-only too; each page uses that backend's own OCR_* settings and cache)
# | lighton_api (LightOnOCR-2-1B through an EU/EEA OpenAI-compatible API: IONOS or EUrouter, OCR_API_* below)
OCR_BACKEND=local
# OCR (local): Unlimited-OCR-2, local CPU (architecture D10, docs/ocr.md)
# CPU threads for torch; empty = number of physical cores
OCR_THREADS=
# gundam = page + 640px tiles (default, best on small print); base = one 1024px view (faster, coarser)
OCR_MODE=
# max output tokens per page (default 3000; a dense A4 page needs ~1300-1800)
OCR_MAX_TOKENS=
# mixed = vision fp32 + decoder bf16 (default); bf16 = all bf16 (slow without AVX512-BF16); mixed-int8head
OCR_DTYPE=
# 0 = model code as is (default); 1 = single-token MoE (same output); 2 = + dense decode attention (~20% faster)
OCR_FAST_DECODE=
# OCR (tesseract): used only when OCR_BACKEND=tesseract (docs/ocr.md)
# Path/name of the tesseract binary (empty = tesseract)
OCR_TESSERACT_CMD=
# Language(s) passed to -l (empty = pol)
OCR_TESSERACT_LANG=
# Render DPI for pypdfium2 + --dpi (empty = 300)
OCR_TESSERACT_DPI=
# Page segmentation mode --psm (0..13; empty = Tesseract default, PSM 3)
OCR_TESSERACT_PSM=
# Directory containing <lang>.traineddata (empty = <JSON4WIN_CACHE_DIR>/tessdata)
OCR_TESSDATA_DIR=
# OCR (lighton): LightOnOCR-2-1B, benchmark-only, needs transformers 5 = .venv-lighton (docs/ocr.md);
# OCR_THREADS applies too. bf16 (default) | fp32 (same text on a test page, 1.5x slower with AVX512-BF16)
OCR_LIGHTON_DTYPE=
# max output tokens per page (empty = 4096)
OCR_LIGHTON_MAX_TOKENS=
# OCR (lighton_api): used only when OCR_BACKEND=lighton_api or a hybrid backend is lighton_api (docs/ocr.md).
# The page image (200 dpi, longest side 1540 px, PNG) is sent to an EU/EEA OpenAI-compatible endpoint.
# Key of the OCR API (IONOS AI Model Hub token, or EUrouter key); never logged. Empty = every page
# goes to OCR_API_FALLBACK with a warning
OCR_API_KEY=
# Base URL (empty = IONOS AI Model Hub, Berlin: https://openai.inference.de-txl.ionos.com/v1);
# EUrouter (Amsterdam, routes to IONOS): https://api.eurouter.ai/api/v1
OCR_API_BASE_URL=
# Model id (empty = lightonai/LightOnOCR-2-1B, the IONOS id); EUrouter: lightonocr-2-1b
OCR_API_MODEL=
# JSON object merged into every request body (empty = none; invalid JSON is an error). EUrouter: pin
# the provider and ask for zero data retention, e.g.
# OCR_API_EXTRA_BODY={"provider": {"only": ["ionos"], "allow_fallbacks": false, "zdr": true, "max_retention_days": 0}}
OCR_API_EXTRA_BODY=
# Output token limit per page (empty = 4096) and sampling (empty = 0 and 1: greedy, like the local
# backend; the IONOS example uses 0.2 / 0.9). These, the host, model and extra body key the cache
OCR_API_MAX_TOKENS=
OCR_API_TEMPERATURE=
OCR_API_TOP_P=
# Seconds per request (empty = 20) and retries on 429/5xx/timeouts (empty = 1); waits between attempts
# follow Retry-After or a 2 s backoff, capped at 5 s. Worst case per page before the fallback:
# (retries + 1) x timeout + retries x 5 s = 45 s with the defaults. After 3 pages in a row fail (any
# failure, incl. an empty answer or no key), the API is not called again in that run (one WARNING) and
# every further page goes to OCR_API_FALLBACK: if the API is down from the start, a run loses <= 3 x 45 s
OCR_API_TIMEOUT=
OCR_API_RETRIES=
# Backend that reads a page when the API fails for it (error, timeout, empty answer, no key):
# tesseract | local | lighton | none (empty = tesseract; none = the document fails). The fallback
# page goes to that backend's own cache
OCR_API_FALLBACK=
# OCR (hybrid): used only when OCR_BACKEND=hybrid. Backend for the first pages: local | tesseract | lighton
# | lighton_api (e.g. OCR_HYBRID_FIRST=lighton_api: page 1 through the API, the rest by Tesseract)
# (empty = lighton)
OCR_HYBRID_FIRST=
# Backend for every later page: local | tesseract | lighton | lighton_api (empty = tesseract)
OCR_HYBRID_REST=
# How many pages OCR_HYBRID_FIRST reads, >= 1 (empty = 1)
OCR_HYBRID_FIRST_PAGES=
# 1 = never run OCR; a page missing from the cache is an error (dev/eval)
OCR_CACHE_ONLY=0

# Cache dir shared by all worktrees; empty = per-user default (~/.cache/json4win, %LOCALAPPDATA%\json4win)
JSON4WIN_CACHE_DIR=

# Extra document-class directories loaded after json4win/config/ (os.pathsep-separated, e.g. config_examples)
JSON4WIN_CONFIG_DIRS=

# Extraction traces (<case>/<name>.trace.json + .trace.md, never in output/); empty = json4win/traces
JSON4WIN_TRACE_DIR=
